<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/waygo_background"
    android:fillViewport="true"
    tools:context=".views.MapFragment">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingTop="16dp"
        android:paddingBottom="28dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="20dp"
            android:paddingEnd="20dp">

            <ImageButton
                android:id="@+id/btnBack"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/bg_circle_soft"
                android:contentDescription="@string/cd_back"
                android:padding="11dp"
                android:src="@drawable/ic_back"
                app:tint="@color/waygo_text_primary" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:letterSpacing="0.08"
                    android:text="@string/map_eyebrow"
                    android:textAllCaps="true"
                    android:textColor="@color/waygo_blue"
                    android:textSize="10sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:fontFamily="sans-serif-medium"
                    android:text="@string/map_title"
                    android:textColor="@color/waygo_text_primary"
                    android:textSize="21sp" />
            </LinearLayout>
        </LinearLayout>

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="380dp"
            android:layout_marginStart="20dp"
            android:layout_marginTop="18dp"
            android:layout_marginEnd="20dp"
            android:background="@drawable/bg_map">

            <ImageButton
                android:id="@+id/btnPin1"
                android:layout_width="46dp"
                android:layout_height="46dp"
                android:background="@drawable/bg_circle_coral_solid"
                android:contentDescription="@string/map_pin_name"
                android:padding="11dp"
                android:src="@drawable/ic_pin"
                app:layout_constraintHorizontal_bias="0.28"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintVertical_bias="0.3"
                app:tint="@color/white" />

            <ImageButton
                android:id="@+id/btnPin2"
                android:layout_width="46dp"
                android:layout_height="46dp"
                android:background="@drawable/bg_circle_blue"
                android:contentDescription="@string/map_pin_name"
                android:padding="11dp"
                android:src="@drawable/ic_pin"
                app:layout_constraintHorizontal_bias="0.68"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintVertical_bias="0.46"
                app:tint="@color/white" />

            <ImageButton
                android:id="@+id/btnPin3"
                android:layout_width="46dp"
                android:layout_height="46dp"
                android:background="@drawable/bg_circle_blue"
                android:contentDescription="@string/map_pin_name"
                android:padding="11dp"
                android:src="@drawable/ic_pin"
                app:layout_constraintHorizontal_bias="0.4"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintVertical_bias="0.72"
                app:tint="@color/white" />
        </androidx.constraintlayout.widget.ConstraintLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:layout_marginTop="14dp"
            android:layout_marginEnd="20dp"
            android:background="@drawable/bg_rounded_16"
            android:elevation="4dp"
            android:orientation="horizontal"
            android:padding="14dp">

            <View
                android:id="@+id/imgMapPhoto"
                android:layout_width="76dp"
                android:layout_height="76dp"
                android:background="@drawable/bg_photo_beach" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:letterSpacing="0.06"
                    android:text="@string/map_suggested"
                    android:textAllCaps="true"
                    android:textColor="@color/waygo_blue"
                    android:textSize="9sp" />

                <TextView
                    android:id="@+id/tvMapName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:fontFamily="sans-serif-medium"
                    android:textColor="@color/waygo_text_primary"
                    android:textSize="16sp" />

                <TextView
                    android:id="@+id/tvMapPlace"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:textColor="@color/waygo_text_secondary"
                    android:textSize="10sp" />

                <TextView
                    android:id="@+id/tvMapDistance"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:fontFamily="sans-serif-medium"
                    android:text="@string/map_pin_distance"
                    android:textColor="@color/waygo_coral"
                    android:textSize="10sp" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
