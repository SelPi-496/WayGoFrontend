<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/nav_graph"
    app:startDestination="@id/exploreFragment">

    <fragment
        android:id="@+id/exploreFragment"
        android:name="com.example.waygofrontend.views.ExploreFragment"
        android:label="@string/nav_explore">
        <action
            android:id="@+id/action_explore_to_planner"
            app:destination="@id/tripPlannerFragment" />
        <action
            android:id="@+id/action_explore_to_detail"
            app:destination="@id/destinationDetailFragment" />
        <action
            android:id="@+id/action_explore_to_service"
            app:destination="@id/serviceFragment" />
        <action
            android:id="@+id/action_explore_to_notifications"
            app:destination="@id/notificationsFragment" />
        <action
            android:id="@+id/action_explore_to_map"
            app:destination="@id/mapFragment" />
        <action
            android:id="@+id/action_explore_to_destinations"
            app:destination="@id/destinationsFragment" />
    </fragment>

    <fragment
        android:id="@+id/tripsFragment"
        android:name="com.example.waygofrontend.views.TripsFragment"
        android:label="@string/nav_trips">
        <action
            android:id="@+id/action_trips_to_itinerary"
            app:destination="@id/itineraryDetailFragment" />
        <action
            android:id="@+id/action_trips_to_planner"
            app:destination="@id/tripPlannerFragment" />
    </fragment>

    <fragment
        android:id="@+id/bookingListFragment"
        android:name="com.example.waygofrontend.views.BookingListFragment"
        android:label="@string/nav_booking">
        <action
            android:id="@+id/action_booking_to_detail"
            app:destination="@id/bookingDetailFragment" />
        <action
            android:id="@+id/action_booking_to_map"
            app:destination="@id/mapFragment" />
    </fragment>

    <fragment
        android:id="@+id/profileFragment"
        android:name="com.example.waygofrontend.views.ProfileFragment"
        android:label="@string/nav_profile">
        <action
            android:id="@+id/action_profile_to_detail"
            app:destination="@id/profileDetailFragment" />
    </fragment>

    <fragment
        android:id="@+id/tripPlannerFragment"
        android:name="com.example.waygofrontend.views.TripPlannerFragment"
        android:label="Travel advisor" />

    <fragment
        android:id="@+id/itineraryDetailFragment"
        android:name="com.example.waygofrontend.views.ItineraryDetailFragment"
        android:label="Itinerary">
        <action
            android:id="@+id/action_itinerary_to_addActivity"
            app:destination="@id/addActivityFragment" />
    </fragment>

    <fragment
        android:id="@+id/addActivityFragment"
        android:name="com.example.waygofrontend.views.AddActivityFragment"
        android:label="Add activity" />

    <fragment
        android:id="@+id/bookingDetailFragment"
        android:name="com.example.waygofrontend.views.BookingDetailFragment"
        android:label="Hotel detail" />

    <fragment
        android:id="@+id/destinationDetailFragment"
        android:name="com.example.waygofrontend.views.DestinationDetailFragment"
        android:label="Destination detail">
        <action
            android:id="@+id/action_detail_to_map"
            app:destination="@id/mapFragment" />
    </fragment>

    <fragment
        android:id="@+id/destinationsFragment"
        android:name="com.example.waygofrontend.views.DestinationsFragment"
        android:label="Destinations">
        <action
            android:id="@+id/action_destinations_to_detail"
            app:destination="@id/destinationDetailFragment" />
    </fragment>

    <fragment
        android:id="@+id/serviceFragment"
        android:name="com.example.waygofrontend.views.ServiceFragment"
        android:label="Service" />

    <fragment
        android:id="@+id/notificationsFragment"
        android:name="com.example.waygofrontend.views.NotificationsFragment"
        android:label="Notifications" />

    <fragment
        android:id="@+id/mapFragment"
        android:name="com.example.waygofrontend.views.MapFragment"
        android:label="Map" />

    <fragment
        android:id="@+id/profileDetailFragment"
        android:name="com.example.waygofrontend.views.ProfileDetailFragment"
        android:label="Profile detail" />
</navigation>
