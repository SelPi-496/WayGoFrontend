<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Base.Theme.WayGoFrontend" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/waygo_blue</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSecondary">@color/waygo_coral</item>
        <item name="colorOnSecondary">@color/white</item>
        <item name="android:colorBackground">@color/waygo_background</item>
        <item name="colorSurface">@color/waygo_surface</item>
        <item name="colorOnSurface">@color/waygo_text_primary</item>
        <item name="colorOutline">@color/waygo_outline</item>
        <item name="android:windowBackground">@color/waygo_background</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@color/waygo_surface</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="27">true</item>
        <item name="bottomSheetDialogTheme">@style/ThemeOverlay.WayGo.BottomSheetDialog</item>
        <item name="android:fontFamily">sans-serif</item>
